# Files and directories listed here are stripped from `git archive` output
# (the release zip produced by bin/build-zip.sh). They are dev-only artifacts
# that must NOT ship to end users installing the plugin on a WordPress site.
#
# NOTE: `test/` (singular — the sample-image fixtures dir) is intentionally NOT
# export-ignored. It is consumed at RUNTIME by self-test features (e.g.
# lib/classes/TestRun.php, SelfTestHelper.php, HTAccess.php copy/convert sample
# images from `test/`), so it must remain in the distributed zip.

/tests/                  export-ignore
/phpunit.xml.dist        export-ignore
/.phpunit.cache/         export-ignore
/.phpunit.result.cache   export-ignore
/.github/                export-ignore
/bin/                    export-ignore
/.gitattributes          export-ignore
/.gitignore              export-ignore
/docs/                   export-ignore
/dist/                   export-ignore
/composer.lock           export-ignore
