{
    "name": "mboisvertdupras/magic-convert",
    "description": "Parallelized, multi-format (WebP + AVIF) image conversion for WordPress. A fork of WebP Express.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "composer/installers": "^1.12.0",
        "rosell-dk/webp-convert": "^2.9.2",
        "rosell-dk/webp-convert-cloud-service": "^2.0.0",
        "kub-at/php-simple-html-dom-parser": "^1.9",
        "rosell-dk/htaccess-capability-tester": "^0.9.0",
        "rosell-dk/image-mime-type-guesser": "^1.1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "scripts": {
        "build": "bash bin/build-zip.sh",
        "test": "phpunit",
        "ci": [
            "@composer validate --no-check-all --strict",
            "@php vendor/bin/phpunit"
        ]
    },
    "authors": [
      {
        "name": "Marc Boisvert-Dupras",
        "homepage": "https://github.com/mboisvertdupras",
        "role": "Fork Author"
      },
      {
        "name": "Bjørn Rosell",
        "homepage": "https://www.bitwise-it.dk/contact",
        "role": "Original Author (WebP Express)"
      }
    ],
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
